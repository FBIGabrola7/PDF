x = [2, 1, 2, 1];
h = [1, 1, 1];

y = conv(x, h);

subplot(3, 1, 1);
stem(0:length(x)-1, x, 'filled');
title('Input Signal x[n]');
xlabel('n');
ylabel('x[n]');
grid on;

subplot(3, 1, 2);
stem(0:length(h)-1, h, 'filled');
title('Impulse Response h[n]');
xlabel('n');
ylabel('h[n]');
grid on;

subplot(3, 1, 3);
stem(0:length(y)-1, y, 'filled');
title('Output Signal y[n]');
xlabel('n');
ylabel('y[n]');
grid on;

disp('Output Signal y[n]:');
disp(y);
