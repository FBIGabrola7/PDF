#include <iostream>
#include <omp.h>
using namespace std;

int main() {
    

#pragma omp parallel 

#pragma omp for 
       for(int i=0;i<3;i++)
           for (int j = 0;j < 8;j++)
           {
               printf("i is %d, J is %d, in the thread number :%d \n", i, j, omp_get_thread_num());
           }

    
}

