//example 6

#include <iostream>
#include <omp.h>
using namespace std;
int main() {
    int sum = 0;
    int local_sum = 0;

#pragma omp parallel
       
#pragma omp for
        for (int i = 0; i < 100; ++i) {
            local_sum += i;
        }
        
#pragma omp critical
       {

          sum += local_sum;
          cout << "local_sum : " <<sum<< endl;
       }   

}





