  Insert at beginning 
void insertAtBeginning(int arr[], int &size, int value) { 
for (int i = size; i > 0; i--) { 
arr[i] = arr[i - 1]; 
} 
arr[0] = value; 
size++; 
} // O(n) 
=======================================================================================
Insert at end 
void insertAtEnd(int arr[], int &size, int value) { 
arr[size] = value; 
size++; 
} // O(1) 
=====================================================================================
Delete at position 
void deleteAtPosition(int arr[], int &size, int pos) { 
for (int i = pos; i < size - 1; i++) { 
arr[i] = arr[i + 1]; 
} 
size--; 
} // O(n) 

