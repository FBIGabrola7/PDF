//first example for loop

#include<iostream>
#include<omp.h>
using namespace std;

int main(){
                #pragma omp parallel 	
		for (int i = 0;i < 10;i++) {
			cout << "thread ID:" << omp_get_thread_num() << endl;
                        cout << "value of i is "<<i <<endl;			
		}
}


