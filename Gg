numerator = [1, -0.5];
denominator = [1, -0.3, 0.2];

subplot(2, 1, 1);
impulse_response = impz(numerator, denominator, 50);
stem(impulse_response, 'filled');
title('الاستجابة النبضية للنظام');
xlabel('n');
ylabel('h[n]');
grid on;

subplot(2, 1, 2);
zplane(numerator, denominator);
title('الأقطاب والأصفار للنظام');
grid on;

disp('معاملات البسط:');
disp(numerator);
disp('معاملات المقام:');
disp(denominator);
